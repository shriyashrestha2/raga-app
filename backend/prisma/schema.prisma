generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CAPTAIN
  FINANCE
  PRODUCTION
  LOGISTICS
  PR
  RETURNER
  NEWBIE
}

enum UpdateTag {
  ANNOUNCEMENT
  COSTUME_LOGISTICS
  CHOREO_NOTES
  FINANCE
}

enum RsvpResponse {
  YES
  NO
}

enum CalendarCategory {
  FINANCE
  PRACTICE
  CAPTAINS
  PRODUCTION
  SOCIAL
  LOGISTICS
}

enum ReminderKind {
  RSVP
  TASK
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum FineStatus {
  UNPAID
  PAID
  WAIVED
}

enum PropCostumeCategory {
  PROP
  COSTUME
}

enum PropCostumeStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  RENTED
}

enum CompApplicationStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum ChoreoReminderKind {
  FORMATION
  CHOREO_NOTE
}

// Onboarding: name + phone go here first, an OTP-style code confirms the
// phone (dev mode: code is returned by the API / logged instead of sent via
// real SMS — see backend/README.md), then POST /auth/select-role creates the
// real User row once a matching role access code is provided. One row per
// phone; re-requesting a code overwrites it and resets `verified`.
model PhoneVerification {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model User {
  id                    String   @id @default(cuid())
  name                  String
  initials              String
  role                  Role
  telegramId            String?  @unique
  email                 String?
  phone                 String?  @unique
  year                  String?
  major                 String?
  bio                   String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime @default(now())

  updates                 Update[]
  notificationsReceived   Update[]                 @relation("UpdateTarget")
  rsvps                   Rsvp[]
  videos                  Video[]
  attendanceRecords       Attendance[]             @relation("AttendanceSubject")
  attendanceMarkedBy      Attendance[]             @relation("AttendanceMarkedBy")
  practiceAttendanceRecords  PracticeAttendance[]  @relation("PracticeAttendanceSubject")
  practiceAttendanceMarkedBy PracticeAttendance[]  @relation("PracticeAttendanceMarkedBy")
  fines                   Fine[]                   @relation("FineTarget")
  finesIssued             Fine[]                   @relation("FineIssuedBy")
  quotas                  Quota[]                  @relation("QuotaSubject")
  quotasCreated           Quota[]                  @relation("QuotaCreatedBy")
  compApplicationsMade    CompApplication[]        @relation("CompAppCreatedBy")
  compApplicationsFor     CompApplication[]        @relation("CompAppAssignedTo")
  propsCostumesCreated    PropCostumeItem[]        @relation("PropCostumeCreatedBy")
  propsCostumesAssigned   PropCostumeAssignment[]
  practicePlansCreated    PracticePlan[]           @relation("PracticePlanCreatedBy")
  choreoRemindersMade     ChoreoReminder[]         @relation("ChoreoReminderCreatedBy")
  calendarEventsCreated   CalendarEvent[]          @relation("CalendarEventCreatedBy")
  remindersCreated        Reminder[]               @relation("ReminderCreatedBy")
  reminderRsvps           ReminderRsvp[]
  reminderTaskCompletions ReminderTaskCompletion[]
  fundsLogged             Fund[]                   @relation("FundCreatedBy")
  quotaContributionsMade  QuotaContribution[]      @relation("QuotaContributionCreatedBy")
  chatMessagesSent        ChatMessage[]            @relation("ChatMessageAuthor")
  chatReactionsMade       ChatReaction[]            @relation("ChatReactionAuthor")
}

model Update {
  id                String    @id @default(cuid())
  author            User      @relation(fields: [authorId], references: [id])
  authorId          String
  tag               UpdateTag
  content           String
  pinned            Boolean   @default(false)
  audienceRole      Role?
  // Comma-separated Role values gating who can see this update; empty means
  // visible to everyone. Same encoding as CalendarEvent.visibleToRoles (see
  // that field's comment) — distinct from audienceRole, which only scopes
  // *posting* to a non-Captain's own channel.
  visibleToRoles    String    @default("")
  telegramMessageId String?   @unique
  createdAt         DateTime  @default(now())

  // Personal notifications (fund logged, fine issued/reminder) target one
  // specific user instead of a role — when set, this overrides visibleToRoles
  // entirely (see updates.ts's canViewUpdate). relatedFineId lets the daily
  // reminder scheduler dedupe "did I already send today's reminder for this
  // fine" without a separate tracking table.
  targetUserId  String?
  targetUser    User?   @relation("UpdateTarget", fields: [targetUserId], references: [id])
  relatedFineId String?
  relatedFine   Fine?   @relation(fields: [relatedFineId], references: [id], onDelete: Cascade)
}

model Practice {
  id        String   @id @default(cuid())
  date      DateTime
  location  String
  focus     String
  reminder  String?
  createdAt DateTime @default(now())

  rsvps      Rsvp[]
  plans      PracticePlan[]
  attendance PracticeAttendance[]
}

model Rsvp {
  id         String       @id @default(cuid())
  practice   Practice     @relation(fields: [practiceId], references: [id])
  practiceId String
  user       User         @relation(fields: [userId], references: [id])
  userId     String
  response   RsvpResponse
  // Required whenever response == NO; enforced at the API layer since
  // Prisma/SQLite can't express a conditional NOT NULL constraint.
  reason     String?
  updatedAt  DateTime     @updatedAt

  @@unique([practiceId, userId])
}

model Video {
  id           String   @id @default(cuid())
  title        String
  set          String
  competition  String?
  date         DateTime
  url          String
  thumbnail    String?
  duration     String?
  pinned       Boolean  @default(false)
  // Required whenever pinned == true; enforced at the API layer since
  // Prisma/SQLite can't express a conditional NOT NULL constraint (same
  // pattern as Rsvp.reason above).
  pinLabel     String?
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById String
  createdAt    DateTime @default(now())
}

model CalendarEvent {
  id             String           @id @default(cuid())
  date           DateTime
  category       CalendarCategory
  label          String
  description    String?
  // Comma-separated Role values gating who can see this event (e.g.
  // "FINANCE,CAPTAIN"); empty string means visible to every role. SQLite has
  // no native array/enum-array column, so this is joined/split in
  // src/routes/calendar.ts rather than modeled as a relation.
  visibleToRoles String           @default("")
  createdById    String?
  createdBy      User?            @relation("CalendarEventCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  attendance Attendance[]
}

// Real check-in/attendance, distinct from Rsvp (which is RSVP-intent on
// Practice only). Attaches to CalendarEvent so "edit attendance only for
// events tagged to my role" reuses the same category->role mapping as
// calendar edit permissions (see backend/src/permissions.ts).
model Attendance {
  id         String           @id @default(cuid())
  event      CalendarEvent    @relation(fields: [eventId], references: [id])
  eventId    String
  user       User             @relation("AttendanceSubject", fields: [userId], references: [id])
  userId     String
  status     AttendanceStatus
  notes      String?
  markedById String
  markedBy   User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  updatedAt  DateTime         @updatedAt

  @@unique([eventId, userId])
}

// Real attendance for a specific Practice session (present/absent/late),
// separate from Attendance (ad-hoc CalendarEvent check-in, above) and from
// Rsvp (RSVP-intent before the practice happens). Practice isn't owned by
// any single board role the way CalendarCategory is, so this is Captain-only
// to mark rather than reusing canEditAttendance's category->role mapping
// (see permissions.ts's canEditPracticeAttendance).
model PracticeAttendance {
  id         String           @id @default(cuid())
  practice   Practice         @relation(fields: [practiceId], references: [id])
  practiceId String
  user       User             @relation("PracticeAttendanceSubject", fields: [userId], references: [id])
  userId     String
  status     AttendanceStatus
  markedById String
  markedBy   User             @relation("PracticeAttendanceMarkedBy", fields: [markedById], references: [id])
  updatedAt  DateTime         @updatedAt

  @@unique([practiceId, userId])
}

// Shared team reminders (Roundup tab, all roles see the same list, filterable
// by category). Only Captains and board positions (Finance/Production/
// Logistics/PR) can create — non-owned categories (PRACTICE/CAPTAINS) are
// Captain-only, and board roles are locked to their own owned category (PR's
// is SOCIAL — see permissions.ts's ownedCategory). Returners/Newbies are
// read + interact only (RSVP or mark-done), never create. Distinct from
// CalendarEvent — reminders don't appear on the team calendar, they just
// reuse its category taxonomy/colors for visual consistency.
model Reminder {
  id          String           @id @default(cuid())
  title       String
  description String?
  date        DateTime
  category    CalendarCategory
  type        ReminderKind
  createdById String
  createdBy   User             @relation("ReminderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  rsvps           ReminderRsvp[]
  taskCompletions ReminderTaskCompletion[]
}

// One per (reminder, user) — only meaningful when the reminder's type is RSVP.
model ReminderRsvp {
  id         String       @id @default(cuid())
  reminder   Reminder     @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  reminderId String
  user       User         @relation(fields: [userId], references: [id])
  userId     String
  response   RsvpResponse
  updatedAt  DateTime     @updatedAt

  @@unique([reminderId, userId])
}

// Row existing = that user marked the task done; only meaningful when the
// reminder's type is TASK. Unmarking deletes the row rather than storing
// done=false, so "done count" is just a row count.
model ReminderTaskCompletion {
  id          String   @id @default(cuid())
  reminder    Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  reminderId  String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  completedAt DateTime @default(now())

  @@unique([reminderId, userId])
}

// Captain-only agenda/timeline planning tool. Distinct from the existing
// Practice/Rsvp headcount tool, which stays visible to every role.
model PracticePlan {
  id          String    @id @default(cuid())
  practice    Practice? @relation(fields: [practiceId], references: [id])
  practiceId  String?
  title       String
  date        DateTime
  createdById String
  createdBy   User      @relation("PracticePlanCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agendaItems PracticeAgendaItem[]
}

model PracticeAgendaItem {
  id             String       @id @default(cuid())
  plan           PracticePlan @relation(fields: [planId], references: [id])
  planId         String
  order          Int
  startOffsetMin Int
  durationMin    Int
  label          String
  notes          String?
}

// Captain-dashboard-only widgets. Not a page, not visible to any other role.
model ChoreoReminder {
  id          String             @id @default(cuid())
  label       String
  kind        ChoreoReminderKind
  resolved    Boolean            @default(false)
  createdById String
  createdBy   User               @relation("ChoreoReminderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model PropCostumeItem {
  id              String              @id @default(cuid())
  name            String
  category        PropCostumeCategory
  status          PropCostumeStatus   @default(NOT_STARTED)
  rentalVendor    String?
  rentalCostCents Int?
  rentalDueDate   DateTime?
  notes           String?
  createdById     String
  createdBy       User                @relation("PropCostumeCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  assignments PropCostumeAssignment[]
}

model PropCostumeAssignment {
  id        String          @id @default(cuid())
  item      PropCostumeItem @relation(fields: [itemId], references: [id])
  itemId    String
  user      User            @relation(fields: [userId], references: [id])
  userId    String
  size      String?
  task      String?
  status    String          @default("PENDING")
  updatedAt DateTime        @updatedAt

  @@unique([itemId, userId])
}

// Fine eligibility (who can be targeted) is unrestricted by role — any
// member, including Captains, can receive a fine. Only send/manage access
// (see permissions.ts: canManageFines) is role-gated.
model Fine {
  id          String     @id @default(cuid())
  user        User       @relation("FineTarget", fields: [userId], references: [id])
  userId      String
  amountCents Int
  reason      String
  status      FineStatus @default(UNPAID)
  issuedById  String
  issuedBy    User       @relation("FineIssuedBy", fields: [issuedById], references: [id])
  issuedAt    DateTime   @default(now())
  paidAt      DateTime?
  updatedAt   DateTime   @updatedAt
  dueDate     DateTime?
  reminders   Update[]
}

model Quota {
  id           String    @id @default(cuid())
  user         User      @relation("QuotaSubject", fields: [userId], references: [id])
  userId       String
  label        String
  unit         String
  targetValue  Float
  // Derived: always equal to the sum of `contributions.amount`. Progress is
  // itemized (each contribution names the event/source it came from) rather
  // than a single manually-adjusted number — see routes/quotas.ts's
  // POST /:id/contributions, the only way currentValue changes.
  currentValue Float     @default(0)
  dueDate      DateTime?
  createdById  String
  createdBy    User      @relation("QuotaCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  contributions QuotaContribution[]
}

// One itemized entry toward a quota's progress (e.g. "Bake Sale — $45").
// Finance chairs/Captains log these as money (or hours, etc.) comes in;
// Quota.currentValue is kept as their running sum rather than being set
// directly, so a member's quota card can always show what it's made of.
model QuotaContribution {
  id          String   @id @default(cuid())
  quota       Quota    @relation(fields: [quotaId], references: [id], onDelete: Cascade)
  quotaId     String
  event       String
  amount      Float
  createdById String
  createdBy   User     @relation("QuotaContributionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model CompApplication {
  id              String                @id @default(cuid())
  competitionName String
  deadline        DateTime
  status          CompApplicationStatus @default(NOT_STARTED)
  packetUrl       String?
  notes           String?
  assignedToId    String?
  assignedTo      User?                 @relation("CompAppAssignedTo", fields: [assignedToId], references: [id])
  createdById     String
  createdBy       User                  @relation("CompAppCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

model Competition {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  location  String?
  createdAt DateTime @default(now())

  financeSection    CompFinanceSection?
  productionSection CompProductionSection?
  logisticsSection  CompLogisticsSection?
  scheduleItems     CompScheduleItem[]
}

model CompFinanceSection {
  id            String      @id @default(cuid())
  competition   Competition @relation(fields: [competitionId], references: [id])
  competitionId String      @unique
  budgetCents   Int         @default(0)
  spentCents    Int         @default(0)
  notes         String?
  updatedAt     DateTime    @updatedAt
}

model CompProductionSection {
  id            String      @id @default(cuid())
  competition   Competition @relation(fields: [competitionId], references: [id])
  competitionId String      @unique
  musicStatus   String?
  costumeStatus String?
  notes         String?
  updatedAt     DateTime    @updatedAt
}

model CompLogisticsSection {
  id                  String      @id @default(cuid())
  competition         Competition @relation(fields: [competitionId], references: [id])
  competitionId       String      @unique
  travelPlan          String?
  lodging             String?
  transportationNotes String?
  updatedAt           DateTime    @updatedAt
}

model CompScheduleItem {
  id            String      @id @default(cuid())
  competition   Competition @relation(fields: [competitionId], references: [id])
  competitionId String
  time          DateTime
  label         String
  notes         String?
}

// Fundraising: a single logged contribution toward the team total. `source`
// is a free-text label (fundraiser, sponsor, etc.) — grouped client-side for
// the breakdown chart rather than modeled as its own lookup table, matching
// how Fine.reason is a free string rather than an enum.
model Fund {
  id          String   @id @default(cuid())
  amountCents Int
  source      String
  dateAdded   DateTime
  createdById String
  createdBy   User     @relation("FundCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// The editable list of standard offenses shown in the Fines Tracker. Most
// offenses have a fixed `amountCents`; a few (see team-app-prd.md /
// the Finance tab spec) don't have one fixed number — those store a
// plain-text `description` of the rule instead and leave `amountCents` null,
// which signals the client to leave the new-fine Amount field blank rather
// than auto-filling it.
model FineScheduleItem {
  id          String   @id @default(cuid())
  offense     String
  amountCents Int?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Chat tab: one flat, team-wide channel — no threads or DMs. Kept
// intentionally simple (per team-app-prd.md's Chat spec) rather than
// modeled after Update/Reminder's role-scoped visibility, since every
// member sees the same stream. `content` may be empty when the message is
// attachment-only — the API layer requires at least one of content/
// attachments (SQLite can't express that as a column constraint, same
// pattern as Rsvp.reason). `pinned` is board-only to set (see
// permissions.ts's canPinChatMessage) but visible/orderable by everyone.
model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  pinned    Boolean  @default(false)
  authorId  String
  author    User     @relation("ChatMessageAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  reactions   ChatReaction[]
  attachments ChatAttachment[]
}

// One row per (message, user) — a user has at most one reaction per message.
// Reacting with a different emoji replaces theirs; reacting again with the
// same emoji clears it. See routes/chat.ts's POST /:id/react.
model ChatReaction {
  id        String      @id @default(cuid())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  user      User        @relation("ChatReactionAuthor", fields: [userId], references: [id])
  userId    String
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([messageId, userId])
}

enum ChatAttachmentKind {
  IMAGE
  FILE
}

// A photo or file attached to a chat message. `url` is a relative path
// served by our own /uploads static route (see storage.ts), matching
// Video.url's pattern — never an arbitrary external link.
model ChatAttachment {
  id            String             @id @default(cuid())
  message       ChatMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId     String
  kind          ChatAttachmentKind
  url           String
  fileName      String
  mimeType      String
  fileSizeBytes Int
  createdAt     DateTime           @default(now())
}

model TeamInfo {
  id          String   @id @default(cuid())
  teamName    String
  season      String
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
}
